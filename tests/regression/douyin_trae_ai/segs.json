[
  {
    "start": 0.0,
    "end": 3.2,
    "text": "如果你還沒有把副立工程運用在你日常的工作流裡"
  },
  {
    "start": 3.2,
    "end": 5.2,
    "text": "那這個視頻肯定會對你有幫助"
  },
  {
    "start": 5.2,
    "end": 7.36,
    "text": "去年我在復旦大學做過一個分享"
  },
  {
    "start": 7.36,
    "end": 9.16,
    "text": "標題叫Beyond the Code"
  },
  {
    "start": 9.16,
    "end": 11.88,
    "text": "翠幾乎能當作任何AI軟件來用"
  },
  {
    "start": 11.88,
    "end": 12.84,
    "text": "反響很熱烈"
  },
  {
    "start": 12.84,
    "end": 14.64,
    "text": "誰能想到一個編程agent"
  },
  {
    "start": 14.64,
    "end": 16.84,
    "text": "被我當作通用agent來用"
  },
  {
    "start": 16.84,
    "end": 20.24,
    "text": "主要是翠很容易實現Compunt Engineering"
  },
  {
    "start": 20.24,
    "end": 21.6,
    "text": "比龍蝦行多了"
  },
  {
    "start": 21.6,
    "end": 22.44,
    "text": "這一篇文章"
  },
  {
    "start": 22.44,
    "end": 23.84,
    "text": "外網有千萬的閱讀"
  },
  {
    "start": 23.84,
    "end": 27.24,
    "text": "是AI大神卡帕西分享的個人知識庫工作流"
  },
  {
    "start": 27.24,
    "end": 29.68,
    "text": "實際上我已經這樣做幾年了"
  },
  {
    "start": 29.68,
    "end": 32.4,
    "text": "我可以在粹里面轻松的附线这样的操作"
  },
  {
    "start": 32.4,
    "end": 34.2,
    "text": "为大家准备了详细的文档"
  },
  {
    "start": 35.04,
    "end": 35.52,
    "text": "第一步"
  },
  {
    "start": 35.52,
    "end": 37.88,
    "text": "社区每当有好的材料我就发给粹"
  },
  {
    "start": 37.88,
    "end": 40.6,
    "text": "无论原本是什么格式都能给它扒下来"
  },
  {
    "start": 40.6,
    "end": 43.0,
    "text": "然后拆解成笔记丢进笔记系统"
  },
  {
    "start": 43.0,
    "end": 45.12,
    "text": "变成个人的Wiki越用越强"
  },
  {
    "start": 45.12,
    "end": 47.72,
    "text": "相当于一个持续进化的知识系统"
  },
  {
    "start": 47.72,
    "end": 49.08,
    "text": "那笔记记多了"
  },
  {
    "start": 49.08,
    "end": 50.8,
    "text": "就能随时综合多篇笔记"
  },
  {
    "start": 50.8,
    "end": 53.68,
    "text": "产出PVT、文章或者视频之类的内容"
  },
  {
    "start": 53.68,
    "end": 56.92,
    "text": "很多AI工具做不到像这样逐步的积攒资产"
  },
  {
    "start": 56.92,
    "end": 58.6,
    "text": "但是虽然粹能做到"
  },
  {
    "start": 58.6,
    "end": 60.78,
    "text": "但作為一個 IDE 界面非常複雜"
  },
  {
    "start": 60.78,
    "end": 61.94,
    "text": "普通人不好上手"
  },
  {
    "start": 61.94,
    "end": 66.18,
    "text": "那這個問題終於在Trace Solo新版本的客戶端上解決了"
  },
  {
    "start": 66.18,
    "end": 68.28,
    "text": "你看 UI 變得非常簡潔"
  },
  {
    "start": 68.28,
    "end": 70.72,
    "text": "而且同時能支持桌面端和 Web 端"
  },
  {
    "start": 70.72,
    "end": 73.62,
    "text": "還專門區分開了做通用任務的 MTC 模式"
  },
  {
    "start": 73.62,
    "end": 75.52,
    "text": "和用於編程的 Code 模式"
  },
  {
    "start": 75.52,
    "end": 78.12,
    "text": "我會用這兩個模式分別給大家決定說明"
  },
  {
    "start": 78.12,
    "end": 79.52,
    "text": "如何發揮它的價值"
  },
  {
    "start": 79.52,
    "end": 82.46,
    "text": "首先要用到Trace Solo新版本的桌面端"
  },
  {
    "start": 82.46,
    "end": 84.66,
    "text": "因為它可以選擇一個本地文件夾"
  },
  {
    "start": 84.66,
    "end": 86.5,
    "text": "作為 AI 的工作空間"
  },
  {
    "start": 86.5,
    "end": 88.5,
    "text": "然后再设置界面命令面板"
  },
  {
    "start": 88.5,
    "end": 90.5,
    "text": "创建几个自定义的命令"
  },
  {
    "start": 90.5,
    "end": 93.5,
    "text": "参考AI大神卡华西的知识库工作流"
  },
  {
    "start": 93.5,
    "end": 96.5,
    "text": "创建社区消化输出的命令"
  },
  {
    "start": 96.5,
    "end": 97.5,
    "text": "然后就能用了"
  },
  {
    "start": 97.5,
    "end": 99.5,
    "text": "在MTC模式里输入邪纲"
  },
  {
    "start": 99.5,
    "end": 101.5,
    "text": "就会弹出我们创建的命令"
  },
  {
    "start": 101.5,
    "end": 103.5,
    "text": "社区一篇文章就太简单了"
  },
  {
    "start": 103.5,
    "end": 104.5,
    "text": "我们设取一个视频"
  },
  {
    "start": 104.5,
    "end": 106.5,
    "text": "你看 它调用了一个技能"
  },
  {
    "start": 106.5,
    "end": 109.5,
    "text": "然后通过运行代码获取视频的诸字稿"
  },
  {
    "start": 109.5,
    "end": 111.5,
    "text": "最后写成一个结构化的文件"
  },
  {
    "start": 111.5,
    "end": 113.5,
    "text": "放在我电脑本地"
  },
  {
    "start": 113.5,
    "end": 114.5,
    "text": "原视频是英文的"
  },
  {
    "start": 114.5,
    "end": 115.5,
    "text": "它还翻译成了中文"
  },
  {
    "start": 115.5,
    "end": 117.5,
    "text": "社区的命令完成了"
  },
  {
    "start": 117.5,
    "end": 118.5,
    "text": "在运行消化命令"
  },
  {
    "start": 118.5,
    "end": 120.5,
    "text": "他给自己制定了一个计划"
  },
  {
    "start": 120.5,
    "end": 123.5,
    "text": "然后自己找出最新社区的文章"
  },
  {
    "start": 123.5,
    "end": 125.5,
    "text": "然后把文章拆解成知识点"
  },
  {
    "start": 125.5,
    "end": 127.5,
    "text": "并且互相建立连接"
  },
  {
    "start": 127.5,
    "end": 129.5,
    "text": "从右边的笔记软件就能看到"
  },
  {
    "start": 129.5,
    "end": 131.5,
    "text": "知识库正在疯狂的生长"
  },
  {
    "start": 131.5,
    "end": 132.5,
    "text": "什么上下文工程"
  },
  {
    "start": 132.5,
    "end": 133.5,
    "text": "语蠢区"
  },
  {
    "start": 133.5,
    "end": 134.5,
    "text": "Harness Engineering"
  },
  {
    "start": 134.5,
    "end": 136.5,
    "text": "比较经典的概念都被提取出来了"
  },
  {
    "start": 136.5,
    "end": 138.5,
    "text": "就像个人的危机百科"
  },
  {
    "start": 138.5,
    "end": 140.5,
    "text": "消化了足够多的知识后"
  },
  {
    "start": 140.5,
    "end": 141.5,
    "text": "就可以输出"
  },
  {
    "start": 141.5,
    "end": 143.5,
    "text": "我们可以切换到靠的模式"
  },
  {
    "start": 143.5,
    "end": 147.2,
    "text": "因为我们要让它输出一个HTML格式的知识卡片"
  },
  {
    "start": 147.2,
    "end": 149.0,
    "text": "调用这个输出命令"
  },
  {
    "start": 149.0,
    "end": 151.3,
    "text": "你看这个结果相当不错"
  },
  {
    "start": 151.3,
    "end": 154.27,
    "text": "输出可以是各种格式的"
  },
  {
    "start": 154.27,
    "end": 156.97,
    "text": "比如生成一篇图文并贸的PDF文章"
  },
  {
    "start": 156.97,
    "end": 159.87,
    "text": "它调用了PDF和图片生成两个skills"
  },
  {
    "start": 159.87,
    "end": 162.27,
    "text": "都是我从技能市场里面直接安装的"
  },
  {
    "start": 162.27,
    "end": 164.37,
    "text": "社区 消化 输出"
  },
  {
    "start": 164.37,
    "end": 165.17,
    "text": "我这么说吧"
  },
  {
    "start": 165.17,
    "end": 166.87,
    "text": "任何一个正经的大项目"
  },
  {
    "start": 166.87,
    "end": 168.87,
    "text": "必然需要一个workspace"
  },
  {
    "start": 168.87,
    "end": 170.47,
    "text": "随着一个任务的推进"
  },
  {
    "start": 170.47,
    "end": 171.27,
    "text": "不断生长"
  },
  {
    "start": 171.27,
    "end": 172.47,
    "text": "变成长期的资产"
  },
  {
    "start": 172.47,
    "end": 175.07,
    "text": "不要再把AI当做一次性的对华窗口"
  },
  {
    "start": 175.07,
    "end": 176.51,
    "text": "再来说扣的模式"
  },
  {
    "start": 176.51,
    "end": 179.23,
    "text": "有时候人在外面可以用吹Solo的网页端"
  },
  {
    "start": 179.23,
    "end": 182.07,
    "text": "让AI在云端帮我们干一些轻量级的工作"
  },
  {
    "start": 182.07,
    "end": 184.59,
    "text": "比如说我有一个刚开发完的web应用"
  },
  {
    "start": 184.59,
    "end": 185.99,
    "text": "以前要人工测试一番"
  },
  {
    "start": 185.99,
    "end": 188.35,
    "text": "而现在我只要把网站发给AI"
  },
  {
    "start": 188.35,
    "end": 193.46,
    "text": "他就使用浏览器帮我做各种测试"
  },
  {
    "start": 193.46,
    "end": 195.02,
    "text": "生成一份测试的报告"
  },
  {
    "start": 195.02,
    "end": 196.78,
    "text": "这里用到一个Dock Food Scale"
  },
  {
    "start": 196.78,
    "end": 198.5,
    "text": "也是从技能市场安装的"
  },
  {
    "start": 198.5,
    "end": 201.78,
    "text": "AI输出的测试报告只出了很多网站上的问题"
  },
  {
    "start": 201.78,
    "end": 204.58,
    "text": "那我要求AI到GitHub上创建Essues"
  },
  {
    "start": 204.58,
    "end": 206.98,
    "text": "这又用到了GitHub CLI的skills"
  },
  {
    "start": 206.98,
    "end": 208.94,
    "text": "这里可以看到弹出一个框"
  },
  {
    "start": 208.94,
    "end": 210.62,
    "text": "当AI要找我们明确需求"
  },
  {
    "start": 210.62,
    "end": 212.46,
    "text": "或者需要我们帮助的时候"
  },
  {
    "start": 212.46,
    "end": 213.06,
    "text": "比如这里"
  },
  {
    "start": 213.06,
    "end": 215.02,
    "text": "他是要找我们帮他登录GitHub"
  },
  {
    "start": 215.02,
    "end": 216.82,
    "text": "他都会主动停下来提问"
  },
  {
    "start": 216.82,
    "end": 217.78,
    "text": "帮他登录之后"
  },
  {
    "start": 217.78,
    "end": 220.84,
    "text": "就顺利创建了数个issues"
  },
  {
    "start": 220.84,
    "end": 222.96,
    "text": "像这样一个运行在云端的agent"
  },
  {
    "start": 222.96,
    "end": 224.24,
    "text": "又不占用本地的资源"
  },
  {
    "start": 224.24,
    "end": 225.64,
    "text": "也不占用个人的时间"
  },
  {
    "start": 225.64,
    "end": 227.2,
    "text": "还能多个任务并行的跑"
  },
  {
    "start": 227.2,
    "end": 229.96,
    "text": "相当于是对ID型态吹的一个补充"
  },
  {
    "start": 229.96,
    "end": 232.72,
    "text": "我们也可以随时一键跳回吹ID里面"
  },
  {
    "start": 232.72,
    "end": 234.28,
    "text": "进行深入的开发"
  },
  {
    "start": 234.28,
    "end": 236.48,
    "text": "你可能会疑惑一个AI开发工具"
  },
  {
    "start": 236.48,
    "end": 238.08,
    "text": "为什么要推出这样的新版本"
  },
  {
    "start": 238.08,
    "end": 240.08,
    "text": "甚至还有什么MTC模式"
  },
  {
    "start": 240.08,
    "end": 240.78,
    "text": "在我看来"
  },
  {
    "start": 240.78,
    "end": 244.28,
    "text": "它是把软件工程场景里已经跑通的agentic庇还"
  },
  {
    "start": 244.28,
    "end": 246.88,
    "text": "迁移到更广泛知识工作者的场景"
  },
  {
    "start": 246.88,
    "end": 248.48,
    "text": "用更低门槛的界面"
  },
  {
    "start": 248.48,
    "end": 251.88,
    "text": "把高度产品化的智能体带给更大的人群"
  }
]